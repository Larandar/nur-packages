diff -ruN a/test/test_fresh_shell.ml b/test/test_fresh_shell.ml
--- a/test/test_fresh_shell.ml
+++ b/test/test_fresh_shell.ml
@@ -0,0 +1,98 @@
+open Alcotest
+open Nixtamal
+
+let parse text =
+	text |> KDL.of_string |> Result.get_ok
+	|> Manifest.Fresh_cmd.codec.of_kdl |> Result.get_ok |> Option.get
+
+let models _ = Jingoo.Jg_types.Tnull
+
+let execute ?(models = models) cmds =
+	Eio_main.run (fun env -> Eio.Switch.run (fun sw ->
+		Foreman.run_pipeline ~sw ~proc_mgr: (Eio.Stdenv.process_mgr env) ~models cmds
+	))
+
+let output ?models cmds =
+	match execute ?models cmds with
+	| Ok b -> Buffer.contents b
+	| Error (exn, stderr) -> fail (Printexc.to_string exn ^ ": " ^ Buffer.contents stderr)
+
+let literal shell value =
+	let open Input.Fresh.Cmd in
+	let t = Input.Template.make in
+	{pipeline = ({prog = t "printf"; args = [t "%s"; t value]}, []); shell}
+
+let suite = [
+	test_case "shell attribute roundtrip" `Quick (fun () ->
+		let cmd = parse {|fresh-cmd shell="nu" { $ http get "https://example.invalid"; | get tag_name; }|} in
+		check (option string) "shell" (Some "nu") cmd.shell;
+		let roundtrip = Manifest.Fresh_cmd.codec.to_kdl (Some cmd)
+			|> Manifest.Fresh_cmd.codec.of_kdl |> Result.get_ok in
+		check (testable Manifest.Fresh_cmd.pp Manifest.Fresh_cmd.equal) "roundtrip" (Some cmd) roundtrip
+	);
+	test_case "invalid shell attributes" `Quick (fun () ->
+		List.iter (fun text ->
+			let result = KDL.of_string text |> Result.get_ok |> Manifest.Fresh_cmd.codec.of_kdl in
+			check bool "rejected" true (Result.is_error result)
+		) [{|fresh-cmd shell="" { $ printf hi; }|}; {|fresh-cmd shell=1 { $ printf hi; }|}]
+	);
+	test_case "direct mode unchanged" `Quick (fun () ->
+		let cmd = parse {|fresh-cmd { $ printf "%s" "hello world"; | tr "a-z" "A-Z"; }|} in
+		check (option string) "no shell" None cmd.shell;
+		check string "output" "HELLO WORLD" (output cmd)
+	);
+	test_case "Nu builtins and subcommands" `Quick (fun () ->
+		let cmd = parse {|fresh-cmd shell="nu" { $ printf "%s" "{\"tag_name\":\"v1.2.3\"}"; | from json; | get tag_name; }|} in
+		check string "release" "v1.2.3" (String.trim (output cmd))
+	);
+	test_case "Nu and POSIX literal arguments" `Quick (fun () ->
+		let value = "x ' \" \\ $(id) $env.HOME ; ` [] | &\n\r\t終 y" in
+		List.iter (fun shell ->
+			check string "literal" value (output (literal (Some shell) value))
+		) ["nu"; "sh"]
+	);
+	test_case "Nu duration and filesize literals stay bare" `Quick (fun () ->
+		let render token =
+			Fresh_shell.script ~models ~shell: "nu" (literal (Some "nu") token).pipeline
+		in
+		List.iter (fun token ->
+			check string "bare" ("printf \"%s\" " ^ token) (render token)
+		) ["30sec"; "1.5min"; "512mib"];
+		List.iter (fun token ->
+			check bool "quoted" true (String.contains (render token) '"')
+		) ["30sec0"; "1.5.2sec"; "30secs"]
+	);
+	test_case "template output stays data" `Quick (fun () ->
+		let value = "\"; print injected; #" in
+		let models = function "payload" -> Jingoo.Jg_types.Tstr value | _ -> Jingoo.Jg_types.Tnull in
+		(* Preserve upstream template semantics, including its default HTML escaping. *)
+		let expected = Input.Template.fill ~models (Input.Template.make "{{payload}}") in
+		check string "literal template" expected (output ~models (literal (Some "nu") "{{payload}}"))
+	);
+	test_case "Nu does not load user configuration" `Quick (fun () ->
+		let cmd = literal (Some "/some/path/nu") "x" in
+		match Fresh_shell.argv ~models ~shell: "/some/path/nu" cmd.pipeline with
+		| [_; "--no-config-file"; "-c"; _] -> ()
+		| _ -> fail "missing configuration isolation"
+	);
+	test_case "Nu failure and stderr propagate" `Quick (fun () ->
+		let cmd = parse {|fresh-cmd shell="nu" { $ sh -c "echo unique-diagnostic >&2; exit 7"; | str trim; }|} in
+		match execute cmd with
+		| Ok _ -> fail "failed command succeeded"
+		| Error (_, stderr) -> check string "stderr" "unique-diagnostic" (String.trim (Buffer.contents stderr))
+	);
+	test_case "missing shell fails" `Quick (fun () ->
+		check bool "failure" true (Result.is_error (execute (literal (Some "/no/such/nixtamal-shell") "x")))
+	);
+	test_case "empty fresh value remains an error" `Quick (fun () ->
+		let cmd = literal (Some "nu") "" in
+		let input = Input.make ~name: (Name.Input.make "empty")
+			~kind: (Input.make_kind_file ~url: (Input.Template.make "https://example.invalid") ())
+			~fresh: (Input.Fresh.make ~cmd ()) () in
+		Eio_main.run (fun env -> Eio.Switch.run (fun sw ->
+			match Foreman.get_fresh ~sw ~proc_mgr: (Eio.Stdenv.process_mgr env) input with
+			| Error (`Fresh (_, `Cmd_output_empty)) -> ()
+			| _ -> fail "empty output was not rejected"
+		))
+	);
+]
