--- a/lib/fresh_shell.ml
+++ b/lib/fresh_shell.ml
@@ -0,0 +1,79 @@
+(* SPDX-License-Identifier: LGPL-2.1-or-later WITH OCaml-LGPL-linking-exception *)
+(* Shell rendering is opt-in; shell metacharacters in arguments are quoted. *)
+let is_nu shell =
+	match Filename.basename shell with "nu" | "nu.exe" -> true | _ -> false
+
+let nu_word s =
+	s <> "" && not (List.mem s ["true"; "false"; "null"; "inf"; "-inf"; "NaN"])
+	&& (match s.[0] with
+		| 'a'..'z' | 'A'..'Z' | '_' -> true
+		| '-' when String.length s > 1 ->
+			(match s.[1] with 'a'..'z' | 'A'..'Z' | '_' | '-' -> true | _ -> false)
+		| _ -> false)
+	&& String.for_all (function
+		| 'a'..'z' | 'A'..'Z' | '0'..'9' | '_' | '-' | '/' | '.' | ':' | '@' | '%' | '+' | '=' | ',' -> true
+		| _ -> false) s
+
+let nu_quote s =
+	let b = Buffer.create (String.length s + 2) in
+	Buffer.add_char b '"';
+	String.iter (function
+		| '"' -> Buffer.add_string b "\\\""
+		| '\\' -> Buffer.add_string b "\\\\"
+		| '\n' -> Buffer.add_string b "\\n"
+		| '\r' -> Buffer.add_string b "\\r"
+		| '\t' -> Buffer.add_string b "\\t"
+		| c when Char.code c < 32 || Char.code c = 127 ->
+			Buffer.add_string b (Printf.sprintf "\\u{%x}" (Char.code c))
+		| c -> Buffer.add_char b c
+	) s;
+	Buffer.add_char b '"';
+	Buffer.contents b
+
+(* Duration & filesize literals like “30sec” stay bare so Nu parses them
+   as measures, not strings; anything else digit-leading is still quoted. *)
+let nu_measure s =
+	let len = String.length s in
+	let is_digit c = c >= '0' && c <= '9' in
+	let rec scan i = if i < len && is_digit s.[i] then scan (i + 1) else i in
+	let units = [
+		"ns"; "us"; "ms"; "sec"; "min"; "hr"; "day"; "wk";
+		"b"; "kb"; "mb"; "gb"; "tb"; "pb";
+		"kib"; "mib"; "gib"; "tib"; "pib";
+	] in
+	if len < 2 then false
+	else
+		let int_end = scan 0 in
+		int_end > 0
+		&& (let unit_start =
+			if int_end < len && s.[int_end] = '.' then
+				let frac_end = scan (int_end + 1) in
+				if frac_end > int_end + 1 then frac_end else -1
+			else int_end
+		in
+		unit_start >= 0 && List.mem (String.sub s unit_start (len - unit_start)) units)
+
+let script ~models ~shell ((first, rest) : Input.Fresh.Cmd.cmd Util.Non_empty_list.t) =
+	let nu = is_nu shell in
+	let fill = Input.Template.fill ~models in
+	let argument value =
+		if nu then (if nu_word value || nu_measure value then value else nu_quote value)
+		else Filename.quote value
+	in
+	let command ({prog; args} : Input.Fresh.Cmd.cmd) =
+		let prog = fill prog in
+		let prog =
+			if not nu then Filename.quote prog
+			else if nu_word prog then prog
+			else if String.starts_with ~prefix: "^" prog then
+				"^" ^ nu_quote (String.sub prog 1 (String.length prog - 1))
+			else "^" ^ nu_quote prog
+		in
+		String.concat " " (prog :: List.map (fun arg -> argument (fill arg)) args)
+	in
+	String.concat " | " (List.map command (first :: rest))
+
+let argv ~models ~shell pipeline =
+	let text = script ~models ~shell pipeline in
+	if is_nu shell then [shell; "--no-config-file"; "-c"; text]
+	else [shell; "-c"; text]
