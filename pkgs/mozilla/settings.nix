# Preference rendering, shared by the Linux install (AutoConfig) and installs
# that are read-only (user.js, e.g. the darwin DMG). A preference is a bare
# bool/int/string (locked) or `{ value; status; }`, status one of `locked`,
# `default` (the user may change it) or `user` (re-asserted every launch).
{lib}: let
  normalise = name: raw: let
    pref =
      if builtins.isAttrs raw
      then {status = "locked";} // raw
      else {
        value = raw;
        status = "locked";
      };
  in
    assert lib.assertMsg (builtins.elem pref.status [
      "locked"
      "default"
      "user"
    ]) "waterfox: preference ${name} has unknown status ${pref.status}";
    assert lib.assertMsg (builtins.any (check: check pref.value) [
      builtins.isBool
      builtins.isInt
      builtins.isString
    ]) "waterfox: preference ${name} must be a bool, an int or a string"; pref;
  render = call: preferences:
    lib.concatStrings (
      lib.mapAttrsToList (
        name: raw: let
          pref = normalise name raw;
        in "${call pref.status}(${builtins.toJSON name}, ${builtins.toJSON pref.value});\n"
      )
      preferences
    );
in {
  # waterfox.cfg. AutoConfig skips its first line, so it is always a comment.
  autoConfig = preferences:
    "// Generated by nur-packages (pkgs/mozilla/settings.nix).\n"
    + render (
      status:
        {
          locked = "lockPref";
          default = "defaultPref";
          user = "pref";
        }
      .${
          status
        }
    )
    preferences;
  # user.js knows only user values: every status becomes `user_pref`, which
  # Waterfox re-reads at each start. Nothing can be locked from a profile.
  userJs = render (_: "user_pref");
  # The TRR preferences privateDns sets, for consumers without the NixOS
  # module (the darwin user.js).
  trrPreferences = {
    url,
    bootstrapAddress ? null,
    strict ? true,
  }:
    {
      "network.trr.mode" =
        if strict
        then 3
        else 2;
      "network.trr.uri" = url;
      "network.trr.custom_uri" = url;
      "doh-rollout.disable-heuristics" = true;
    }
    // lib.optionalAttrs (bootstrapAddress != null) {"network.trr.bootstrapAddr" = bootstrapAddress;};
}
