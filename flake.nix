{
  description = "My personal NUR repository";
  outputs = {self}: let
    nixpkgs = (import ./nix/tamal {}).nixpkgs;
    lib = import "${nixpkgs}/lib";
    forAllSystems = f: lib.genAttrs lib.systems.flakeExposed (system: f (import nixpkgs {inherit system;}));
  in {
    legacyPackages = forAllSystems (pkgs: import ./default.nix {inherit pkgs;});
    packages = lib.mapAttrs (_: lib.filterAttrs (_: lib.isDerivation)) self.legacyPackages;
    nixosModules = {
      searchwala-calf = ./modules/searchwala-calf/nixos.nix;
      waterfox = ./modules/waterfox/nixos.nix;
    };
    homeModules.waterfox = ./modules/waterfox/home.nix;
    darwinModules = {
      searchwala-calf = ./modules/searchwala-calf/darwin.nix;
      waterfox = ./modules/waterfox/darwin.nix;
    };
    # Per system, because the library takes a package set: a consumer asks for the
    # one matching its own nixpkgs, or imports <nur>/lib with its own pkgs.
    lib = forAllSystems (pkgs: import ./lib {inherit pkgs;});
    checks = forAllSystems (pkgs: {
      ci-prepare = import ./checks/ci-prepare.nix {inherit pkgs;};
      workflow = import ./checks/workflow.nix {inherit pkgs;};
      aspects = import ./checks/aspects.nix {
        inherit pkgs;
        aspects = (import ./lib {inherit pkgs;}).aspects;
      };
    });
    # nix/tamal/default.nix is generated by nixtamal and rewritten on every lock.
    formatter = forAllSystems (pkgs:
      pkgs.writeShellScriptBin "alejandra" ''
        exec ${lib.getExe pkgs.alejandra} --exclude ./nix/tamal "$@"
      '');
  };
}
